; Halcyon: Godot 4.7 project (Forward+)
config_version=5

[application]

config/name="Halcyon"
config/description="A seaside hotel, a pistol, and the people in its corridors."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": false,
"mipmaps/generate": true
}

[input]

fire={"deadzone": 0.5, "events": []}

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/use_physical_light_units=false
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/msaa_3d=0
environment/ssao/quality=2
environment/ssil/quality=2
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/screen_space_reflection/roughness_quality=2
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=2
global_illumination/gi/use_half_resolution=true
limits/cluster_builder/max_clustered_elements=1024.0
textures/vram_compression/import_etc2_astc=true
